#!/usr/bin/env bash
# Starts Claude Code + the Cockpit dashboard side by side in one tmux session.
#
# Session resolution: the SessionStart hook writes current-session.json, the
# app reads it itself — the launcher only hands over the target folder.
#
# Cleanup discipline (2026-08-04, after the ruin incident):
#  - Orphaned dashboard processes are killed before startup. Otherwise they
#    survive their pane being torn down and draw multiple copies into the
#    same terminal — visible as stacked-up cards.
#  - An existing session is only reused if it is INTACT (exactly 2 panes). A
#    ruin is torn down instead of attached to.
#  - When Claude ends, the whole session ends. Otherwise a pointless
#    dashboard pane is left standing as a ruin.
set -euo pipefail

COCKPIT="$HOME/.claude/cockpit"
NAME="cockpit-$(basename "$PWD" | tr -c 'a-zA-Z0-9' '-' | sed 's/-*$//')"
APP_PATTERN='tsx src/ui/app.tsx'

[ -d "$COCKPIT" ] || { echo "Cockpit installation missing: $COCKPIT" >&2; exit 1; }

# --- 0. Loudly report the terminal precondition (no abort, no silent fallback) --
# ⌘1-7 only reach the dashboard if GHOSTTY itself translates the keybinding
# into an escape sequence (config/ghostty-snippet.conf). This check must run
# BEFORE `tmux new-session`: $TERM_PROGRAM here is still the value of the
# OUTER terminal — once tmux is attached, tmux itself overwrites TERM_PROGRAM
# for every pane process to "tmux" (measured 2026-09-23), which makes this
# the last reliable place to check it.
if [ "${TERM_PROGRAM:-}" != "ghostty" ]; then
  echo "⚠ Terminal is '${TERM_PROGRAM:-unknown}', not Ghostty: ⌘1-7 will not arrive as a keybinding in this session, the cards are not reachable via keyboard. See README 'Setup (one-time)'." >&2
fi

# --- 1. Kill orphaned dashboards (only ones without a live tmux pane) --------
# NOTE: the dashboard is started via `exec`, so it IS the pane process
# itself. Matching only on the parent would kill a legitimately running
# dashboard. So its own PID, its parent, and its grandparent are checked
# (npx can insert an intermediate stage).
candidates=$(pgrep -f "$APP_PATTERN" || true)
if [ -n "$candidates" ]; then
  live_panes=$(tmux list-panes -a -F '#{pane_pid}' 2>/dev/null || true)
  for pid in $candidates; do
    ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ' || true)
    gpid=""
    [ -n "$ppid" ] && gpid=$(ps -o ppid= -p "$ppid" 2>/dev/null | tr -d ' ' || true)
    attached=0
    for probe in "$pid" "$ppid" "$gpid"; do
      [ -n "$probe" ] && grep -qx "$probe" <<<"$live_panes" && attached=1
    done
    if [ "$attached" = "0" ]; then
      kill "$pid" 2>/dev/null || true
      echo "▸ orphaned dashboard killed (PID $pid)"
    fi
  done
fi

# --- 2. Only reuse an existing session if it is intact -----------------------
if tmux has-session -t "$NAME" 2>/dev/null; then
  panes=$(tmux list-panes -t "$NAME" 2>/dev/null | wc -l | tr -d ' ')
  if [ "$panes" = "2" ]; then
    exec tmux attach -t "$NAME"
  fi
  echo "▸ incomplete session '$NAME' ($panes pane(s)) — rebuilding"
  tmux kill-session -t "$NAME" 2>/dev/null || true
fi

# --- 3. Rebuild ---------------------------------------------------------------
# When Claude ends, the whole session is torn down (no ruin pane left behind).
tmux -f "$COCKPIT/config/tmux-cockpit.conf" new-session -d -s "$NAME" -c "$PWD" \
  "claude; tmux kill-session -t '$NAME'"

# stderr goes to the build log: if the dashboard crashes, its pane closes
# cleanly (no ruin left visible) — the reason is in dashboard.log.
tmux split-window -h -l 48 -t "$NAME" -c "$COCKPIT" \
  "COCKPIT_TARGET_CWD='$PWD' exec npx tsx src/ui/app.tsx 2>>'$COCKPIT/dashboard.log'"

tmux select-pane -t "$NAME:0.0"
exec tmux attach -t "$NAME"
