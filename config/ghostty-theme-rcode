# Ghostty theme "rcode" — the R.Code for Claude Code "Terminal" palette.
#
# Install (one-time):
#   mkdir -p ~/.config/ghostty/themes
#   cp config/ghostty-theme-rcode ~/.config/ghostty/themes/rcode
#   echo 'theme = rcode' >> ~/.config/ghostty/config
#   then reload Ghostty (⌘+Shift+,)
#
# Why a palette and not hex colors in the dashboard: the Cockpit draws with
# the terminal's named colors (gray borders, cyan focus, green/yellow/red
# status). Mapping those ANSI slots to the brand tokens makes the dashboard
# AND Claude Code in the left pane look like the design, without the
# dashboard hard-coding colors a user could not theme.
#
# Token source: design system "R.Code for Claude Code", tokens.json (dark).
#   ground #0c0c0c · surface #151515 · line #3a3a3a · ink #ececec
#   muted #9a9a9a · clay #d97757 · go #5fb800 · wait #d4a900
#   stop #ff5c5c · focus #34d1d6

background = #0c0c0c
foreground = #ececec
cursor-color = #ececec
cursor-text = #0c0c0c
selection-background = #3a3a3a
selection-foreground = #ececec

# 0 black · 1 red=stop · 2 green=go · 3 yellow=wait · 4 blue (no brand
# token; a quiet blue for tools that use it) · 5 magenta=clay · 6 cyan=focus
# · 7 white
palette = 0=#151515
palette = 1=#ff5c5c
palette = 2=#5fb800
palette = 3=#d4a900
palette = 4=#6f9fd8
palette = 5=#d97757
palette = 6=#34d1d6
palette = 7=#bdbdbd
# 8 bright black = the Cockpit's "gray" card border. The design line is
# #3a3a3a; #5f5f5f keeps shell hints and dimmed text that also use slot 8
# readable on #0c0c0c.
palette = 8=#5f5f5f
palette = 9=#ff7b7b
palette = 10=#7fd61f
palette = 11=#f0c419
palette = 12=#8fb6e8
palette = 13=#e8906f
palette = 14=#5fe3e7
palette = 15=#ffffff

window-padding-x = 12
window-padding-y = 8
